##
## The category names and health sentences key off ONE list of category
## ceilings, $aqi_tops, which mirrors the ceilings
## AQI.compute_pm2_5_aqi_color() switches on in bin/user/airlink.py; a test
## fails if the two ever drift apart.  Nothing else here re-derives a
## category: the dial's six segments are literals of the EPA palette, and
## every color that depends on a reading -- the pill, the tile swatches, the
## hourly cells -- comes from the pm2_5_aqi_color xtype, so the extension's
## own code decides it.
#errorCatcher Echo
#encoding UTF-8
#from weewx.units import ValueHelper
#import html
#import math
##
## The category ceilings, lowest first.  The top category is open-ended
## (compute_pm2_5_aqi has no upper cap), so this list holds the five
## boundaries and anything above the last lands in the sixth category.
#set $aqi_tops = [50, 100, 150, 200, 300]
##
#set $aqi_names = []
#silent $aqi_names.append($gettext("Good"))
#silent $aqi_names.append($gettext("Moderate"))
#silent $aqi_names.append($gettext("Unhealthy for Sensitive Groups"))
#silent $aqi_names.append($gettext("Unhealthy"))
#silent $aqi_names.append($gettext("Very Unhealthy"))
#silent $aqi_names.append($gettext("Hazardous"))
##
#set $aqi_blurbs = []
#silent $aqi_blurbs.append($gettext("Air quality is satisfactory, and air pollution poses little or no risk."))
#silent $aqi_blurbs.append($gettext("Acceptable.  Unusually sensitive people should consider limiting prolonged outdoor exertion."))
#silent $aqi_blurbs.append($gettext("Sensitive groups may experience health effects.  The general public is less likely to be affected."))
#silent $aqi_blurbs.append($gettext("Some members of the general public may experience health effects."))
#silent $aqi_blurbs.append($gettext("Health alert: the risk of health effects is increased for everyone."))
#silent $aqi_blurbs.append($gettext("Health warning of emergency conditions: everyone is more likely to be affected."))
## The page is a sample, but it is meant to be USED -- most stations put it
## straight on their site -- so it wears the station's own name rather than
## this extension's.  location is [Station] location in weewx.conf.  The
## whole phrase is one translatable string, preposition included, so a
## translator controls the word order: German wants "Luftqualitat in X",
## English wants "X Air Quality".
## StationInfo defaults location to the literal 'Unknown' when weewx.conf
## sets none, which would read as "Unknown Air Quality"; treat that and a
## blank the same way, and fall back to the bare phrase.
#set $site = $station.location.strip() if $station.location else ''
#set $site = '' if $site == 'Unknown' else $site
## The location is the one user-written string on this page, and it reaches
## both <title> and <h1>.  encoding = html_entities only transcodes non-ASCII;
## it does not escape markup, so a location carrying & or < emits raw markup
## and can fail the HTML validator.  Escape before .format(): the surrounding
## phrase is ours, the location is not.  quote=False because both uses are
## element content, not attributes -- "Coeur d'Alene" should not come out as
## "Coeur d&#x27;Alene".
#set $site = html.escape($site, quote=False)
#if $site
#set $heading = $gettext("{location} Air Quality").format(location=$site)
#else
#set $heading = $gettext("Air Quality")
#end if
<!DOCTYPE html>
<html lang="$lang">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>$heading</title>
    <style>
      body {
        margin: 0;
        background: #f4f6f8;
        color: #2b3440;
        font-family: "Helvetica Neue", Helvetica, Arial, system-ui, sans-serif;
        line-height: 1.5;
      }
      .page { max-width: 1080px; margin: 0 auto; padding: 24px 16px 48px; }

      .masthead { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-bottom: 16px; }
      .masthead h1 { margin: 0; font-size: 21px; font-weight: 700; letter-spacing: -.01em; }
      .masthead .when { font-size: 13px; color: #7b8794; }

      .card {
        background: #fff;
        border: 1px solid #dfe4e9;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(20, 32, 45, .05);
      }
      .card > h2 {
        margin: 0;
        padding: 13px 18px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .11em;
        text-transform: uppercase;
        color: #7b8794;
        border-bottom: 1px solid #eef1f4;
      }

      /* The dial, and the verdict beside it. */
      .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; padding: 8px 22px 20px; }
      .gauge { flex: 0 0 300px; max-width: 100%; }
      .gauge svg { width: 100%; height: auto; display: block; }
      .gauge .num { font: 700 46px "Helvetica Neue", Helvetica, Arial, sans-serif; }
      .gauge .unit { font: 700 12px "Helvetica Neue", Helvetica, Arial, sans-serif; fill: #9aa5b1; letter-spacing: .12em; }
      .gauge .end { font: 600 10px "Helvetica Neue", Helvetica, Arial, sans-serif; fill: #9aa5b1; }

      .verdict { flex: 1 1 300px; min-width: 260px; }
      .verdict .pill {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 10px;
      }
      .verdict p { margin: 0 0 16px; font-size: 14.5px; line-height: 1.5; color: #4a5766; max-width: 48ch; }

      .pms { display: flex; flex-wrap: wrap; gap: 26px; }
      .pms .k {
        font-size: 11px; font-weight: 700; letter-spacing: .08em;
        text-transform: uppercase; color: #8a95a1;
      }
      .pms .v { font-size: 21px; font-weight: 700; white-space: nowrap; }

      /* One cell per hour of the last twenty-four. */
      .strip { padding: 16px 18px 18px; }
      .strip-cells { display: flex; gap: 2px; }
      .strip-cells span { flex: 1; height: 42px; border-radius: 3px; display: block; }
      .strip-axis {
        display: flex;
        justify-content: space-between;
        margin-top: 6px;
        font-size: 11px;
        color: #8a95a1;
      }

      .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin: 14px 0; }
      .tile { background: #fff; border: 1px solid #dfe4e9; border-radius: 12px; padding: 14px 16px; }
      .tile .k {
        font-size: 11px; font-weight: 700; letter-spacing: .09em;
        text-transform: uppercase; color: #8a95a1; margin-bottom: 6px;
      }
      .tile .v { font-size: 30px; font-weight: 700; line-height: 1.1; }
      .tile .v em { font-style: normal; font-size: 13px; font-weight: 600; color: #7b8794; }
      .tile .sub { margin-top: 4px; font-size: 12px; color: #8a95a1; }
      .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 2px; vertical-align: 1px; margin-right: 5px; }

      .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 22px 0 14px; }
      .tabs button {
        padding: 9px 22px; font: inherit; font-size: 14px; font-weight: 600;
        color: #52616f; background: #e7ebef; border: 0; border-radius: 999px; cursor: pointer;
      }
      .tabs button:hover { background: #dbe1e7; }
      .tabs button[aria-selected="true"] { background: #367ba3; color: #fff; }
      .plots { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding: 14px; }
      .plots img { max-width: 100%; }

      .unavailable { padding: 26px 22px; font-size: 19px; color: #7b8794; }
    </style>
  </head>
  <body>
    <div class="page">

      <div class="masthead">
        <h1>$heading</h1>
        <span class="when">$current.dateTime</span>
      </div>

#if $current.pm2_5_aqi.has_data
##
#set $aqi = int($current.pm2_5_aqi.raw)
#set $idx = len([t for t in $aqi_tops if $aqi > t])
#set $rgbint = int($current.pm2_5_aqi_color.raw)
#set $red   = ($rgbint >> 16) & 255
#set $green = ($rgbint >>  8) & 255
#set $blue  =  $rgbint        & 255
#set $hexcolor = '#%02x%02x%02x' % ($red, $green, $blue)
## Pick the ink off the swatch's perceived brightness rather than off a
## breakpoint, so the pill stays readable if the palette in airlink.py ever
## changes.  The split is three and three: green 134, orange 150 and yellow
## 226 take the dark ink; maroon 42, red 76 and purple 97 take white.
#set $ink = '#ffffff' if ($red * 299 + $green * 587 + $blue * 114) / 1000 < 128 else '#182028'
#set $numfill = $hexcolor if $ink == '#ffffff' else '#1d2430'
## Six equal segments, one per category, so every category stays legible;
## the tick sits proportionally inside the segment the reading falls in.
#set $cat_lo = 0 if $idx == 0 else $aqi_tops[$idx - 1] + 1
#set $cat_hi = 500 if $idx >= len($aqi_tops) else $aqi_tops[$idx]
#set $within = float($aqi - $cat_lo) / float($cat_hi - $cat_lo) if $cat_hi > $cat_lo else 0.0
#set $within = max(0.0, min(1.0, $within))
#set $radians = (180.0 - ($idx + $within) * 30.0) * math.pi / 180.0
#set $tick_x0 = '%.1f' % (150.0 + 101.0 * math.cos($radians))
#set $tick_y0 = '%.1f' % (158.0 - 101.0 * math.sin($radians))
#set $tick_x1 = '%.1f' % (150.0 + 135.0 * math.cos($radians))
#set $tick_y1 = '%.1f' % (158.0 - 135.0 * math.sin($radians))
      <section class="card">
        <h2>$gettext("Right now")</h2>
        <div class="hero">
          <div class="gauge">
            <svg viewBox="0 0 300 192" role="img" aria-label="$obs.label.pm2_5_aqi $current.pm2_5_aqi">
              <path d="M32.0 155.5A118 118 0 0 1 46.6 101.2" fill="none" stroke="#00e400" stroke-width="22"/>
              <path d="M49.1 96.9A118 118 0 0 1 88.9 57.1" fill="none" stroke="#ffff00" stroke-width="22"/>
              <path d="M93.2 54.6A118 118 0 0 1 147.5 40.0" fill="none" stroke="#ff7e00" stroke-width="22"/>
              <path d="M152.5 40.0A118 118 0 0 1 206.8 54.6" fill="none" stroke="#ff0000" stroke-width="22"/>
              <path d="M211.1 57.1A118 118 0 0 1 250.9 96.9" fill="none" stroke="#8f3f97" stroke-width="22"/>
              <path d="M253.4 101.2A118 118 0 0 1 268.0 155.5" fill="none" stroke="#7e0023" stroke-width="22"/>
              <line x1="$tick_x0" y1="$tick_y0" x2="$tick_x1" y2="$tick_y1" stroke="#ffffff" stroke-width="8" stroke-linecap="round"/>
              <line x1="$tick_x0" y1="$tick_y0" x2="$tick_x1" y2="$tick_y1" stroke="#1d2430" stroke-width="4" stroke-linecap="round"/>
              <text class="num" x="150" y="144" text-anchor="middle" fill="$numfill">$current.pm2_5_aqi.format(add_label=False)</text>
              <text class="unit" x="150" y="164" text-anchor="middle">$unit.label.pm2_5_aqi</text>
              <text class="end" x="32" y="180" text-anchor="middle">0</text>
              <text class="end" x="268" y="180" text-anchor="middle">500</text>
            </svg>
          </div>
          <div class="verdict">
            <span class="pill" style="background:$hexcolor;color:$ink;">$aqi_names[$idx]</span>
            <p>$aqi_blurbs[$idx]</p>
            <div class="pms">
              <div><div class="k">$obs.label.pm1_0</div><div class="v">$current.pm1_0</div></div>
              <div><div class="k">$obs.label.pm2_5</div><div class="v">$current.pm2_5</div></div>
              <div><div class="k">$obs.label.pm10_0</div><div class="v">$current.pm10_0</div></div>
            </div>
          </div>
        </div>
      </section>
##
## GATE ON pm2_5, NOT ON pm2_5_aqi.  $day.<obs>.has_data resolves through
## the 'not_null' aggregate, which AQI does not implement, so WeeWX falls
## through to XTypeTable -- which walks the day's records calling get_scalar
## and catches only CannotCalculate.  AQI.get_scalar raises UnknownType on a
## NULL pm2_5, so if the day's FIRST record is null the walk dies before it
## reaches a good one and $day.pm2_5_aqi.has_data is False for the whole day
## -- even though max/avg/min all answer fine.  (A null later in the day is
## harmless: the walk has already found a value and returned True.)  The
## day's first record is precisely the one an outage across midnight leaves
## null: the catchup records WeeWX archives on restart, for periods no proxy
## could backfill.  That is when this block matters most.
## pm2_5 is a real column, its has_data is the plain SQL one, and everything
## below derives from pm2_5 anyway.  ('not_null' itself arrived in WeeWX
## 4.6.0 -- the same release as the $gettext this template already needs, so
## the gate costs no floor either way.)
## The hourly strip and the hours-above-Good tile sit inside this gate even
## though they measure a TRAILING 24 hours rather than today.  That reads like
## a bug and is not one: $day is archiveDaySpan(report time) and $current is
## the record AT that time, so $current always falls inside $day.  has_data
## can therefore only be false here when $current.pm2_5 is null too -- and the
## outer $current.pm2_5_aqi.has_data gate has already sent the page to its
## Unavailable branch.  (At exactly midnight $day resolves to the PREVIOUS
## day, and the record belongs to it.)  Checked against a real archive; the
## strip is not reachable in a hidden state.  Move these out only if that
## outer gate ever stops covering them.
#if $day.pm2_5.has_data
#set $peak_idx = len([t for t in $aqi_tops if int($day.pm2_5_aqi.max.raw) > t])
#set $mean_idx = len([t for t in $aqi_tops if int($day.pm2_5_aqi.avg.raw) > t])
#set $low_idx  = len([t for t in $aqi_tops if int($day.pm2_5_aqi.min.raw) > t])
## Every swatch is the xtype's own color for that aggregate: the max of
## pm2_5_aqi_color is the color of the day's highest pm2_5, and so on.
#set $peak_swatch = '#%06x' % int($day.pm2_5_aqi_color.max.raw)
#set $mean_swatch = '#%06x' % int($day.pm2_5_aqi_color.avg.raw)
#set $low_swatch  = '#%06x' % int($day.pm2_5_aqi_color.min.raw)
## Two series over the same trailing day: the colors paint the cells, the
## AQIs supply the count and the per-cell tooltip.  Averaging a color is
## meaningful here only because the xtype averages the underlying pm2_5 and
## colors THAT -- see AQI.get_aggregate.  ArchiveTable.get_series skips the
## buckets that fall outside the archive's own span, so this can come back
## with fewer than 24 entries, or none at all; everything downstream of it
## is guarded on $stops rather than assuming 24.
#set $strip_colors = $span($hour_delta=24).pm2_5_aqi_color.series(aggregate_type='avg', aggregate_interval=3600)
#set $strip_aqis = $span($hour_delta=24).pm2_5_aqi.series(aggregate_type='avg', aggregate_interval=3600)
#set $stops = $strip_colors.stop.raw
#set $hourly = $strip_aqis.data.raw
#set $above = len([v for v in $hourly if v is not None and v > $aqi_tops[0]])
## Clock times go through WeeWX's own Formatter rather than strftime, so a
## station that has set [Units] [[TimeFormats]] gets its preference here too.
## $current.formatter is this report's formatter -- the same object behind
## $current.dateTime -- and the 'day' context is the one skin.conf sets to
## %H:%M, which is what these narrow labels need and what a station overrides.
#set $cells = []
#for $i, $c in enumerate($strip_colors.data.raw)
#set $stamp = str(ValueHelper(($stops[$i], 'unix_epoch', 'group_time'), 'day', $current.formatter))
#if $c is None or $hourly[$i] is None
#silent $cells.append(('#e7ebef', $stamp))
#else
#silent $cells.append(('#%06x' % int($c), '%s: %d%s' % ($stamp, int($hourly[$i]), $unit.label.pm2_5_aqi)))
#end if
#end for
## Four evenly spaced labels -- but de-duplicated, because a series with
## fewer than four buckets (a station whose archive is an hour or two old)
## would otherwise repeat one: two buckets give [0, 0, 1, 1], and the axis
## reads 14:10 14:10 15:10 15:10.
#set $axis = []
#set $axis_seen = []
#for $i in ([0, len($stops) // 3, 2 * len($stops) // 3, len($stops) - 1] if $stops else [])
#if $i not in $axis_seen
#silent $axis_seen.append($i)
#silent $axis.append(str(ValueHelper(($stops[$i], 'unix_epoch', 'group_time'), 'day', $current.formatter)))
#end if
#end for
## The AQI is a non-decreasing function of pm2_5, so the hour the AQI peaked
## is the hour pm2_5 peaked -- and pm2_5 is a real column, so its maxtime
## comes straight from the day summaries.  $day.pm2_5_aqi.maxtime is not an
## error (the xtype's own aggregates are avg, count, first, last, min and
## max, and WeeWX serves the rest by walking the records itself) but it is
## worse twice over: it reads every archive row instead of the summary, and
## it raises UnknownAggregation if ANY record in the span is null.
      <div class="tiles">
        <div class="tile">
          <div class="k">$gettext("Today's peak")</div>
          <div class="v"><span class="swatch" style="background:$peak_swatch;"></span>$day.pm2_5_aqi.max.format(add_label=False)<em>$unit.label.pm2_5_aqi</em></div>
          <div class="sub">$aqi_names[$peak_idx] &mdash; $day.pm2_5.maxtime</div>
        </div>
        <div class="tile">
          <div class="k">$gettext("Today's average")</div>
          <div class="v"><span class="swatch" style="background:$mean_swatch;"></span>$day.pm2_5_aqi.avg.format(add_label=False)<em>$unit.label.pm2_5_aqi</em></div>
          <div class="sub">$aqi_names[$mean_idx]</div>
        </div>
        <div class="tile">
          <div class="k">$gettext("Today's low")</div>
          <div class="v"><span class="swatch" style="background:$low_swatch;"></span>$day.pm2_5_aqi.min.format(add_label=False)<em>$unit.label.pm2_5_aqi</em></div>
          <div class="sub">$aqi_names[$low_idx]</div>
        </div>
#if $stops
        <div class="tile">
          <div class="k">$gettext("Hours above Good")</div>
          <div class="v">$above</div>
          <div class="sub">$gettext("in the last 24 hours")</div>
        </div>
#end if
      </div>

#if $stops
      <section class="card">
        <h2>$gettext("The last 24 hours, hour by hour")</h2>
        <div class="strip">
          <div class="strip-cells">
#for $bg, $tip in $cells
            <span style="background:$bg;" title="$tip"></span>
#end for
          </div>
          <div class="strip-axis">
#for $label in $axis
            <span>$label</span>
#end for
          </div>
        </div>
      </section>
#end if
#end if
##
#else
      <section class="card">
        <h2>$gettext("Right now")</h2>
        <p class="unavailable">$obs.label.pm2_5_aqi: $gettext("Unavailable")</p>
      </section>
#end if

      <div class="tabs" role="tablist">
        <button type="button" role="tab" id="day" onclick="clickDay()" aria-controls="day_block" aria-selected="true">$gettext("Day")</button>
        <button type="button" role="tab" id="week" onclick="clickWeek()" aria-controls="week_block" aria-selected="false">$gettext("Week")</button>
        <button type="button" role="tab" id="month" onclick="clickMonth()" aria-controls="month_block" aria-selected="false">$gettext("Month")</button>
        <button type="button" role="tab" id="year" onclick="clickYear()" aria-controls="year_block" aria-selected="false">$gettext("Year")</button>
      </div>

      <section class="card">
        <h2>$gettext("History")</h2>
        <div id="day_block" class="plots" role="tabpanel" aria-labelledby="day">
          <img src="dayaqi.png" alt="$obs.label.pm2_5_aqi">
          <img src="daypm2_5.png" alt="$obs.label.pm2_5">
        </div>
        <div id="week_block" class="plots" role="tabpanel" aria-labelledby="week" style="display:none;">
          <img src="weekaqi.png" alt="$obs.label.pm2_5_aqi">
          <img src="weekpm2_5.png" alt="$obs.label.pm2_5">
        </div>
        <div id="month_block" class="plots" role="tabpanel" aria-labelledby="month" style="display:none;">
          <img src="monthaqi.png" alt="$obs.label.pm2_5_aqi">
          <img src="monthpm2_5.png" alt="$obs.label.pm2_5">
        </div>
        <div id="year_block" class="plots" role="tabpanel" aria-labelledby="year" style="display:none;">
          <img src="yearaqi.png" alt="$obs.label.pm2_5_aqi">
          <img src="yearpm2_5.png" alt="$obs.label.pm2_5">
        </div>
      </section>

    </div>
    <script>
      function resetAirLinkMenuBar() {
        var periods = ['day', 'week', 'month', 'year'];
        for (var i = 0; i < periods.length; i++) {
          document.getElementById(periods[i]).setAttribute('aria-selected', 'false');
          document.getElementById(periods[i] + '_block').style.display = 'none';
        }
      }
      function clickAirLinkPeriod(period) {
        resetAirLinkMenuBar();
        document.getElementById(period).setAttribute('aria-selected', 'true');
        document.getElementById(period + '_block').style.display = 'flex';
      }
      function clickDay() {
        clickAirLinkPeriod('day');
      }
      function clickWeek() {
        clickAirLinkPeriod('week');
      }
      function clickMonth() {
        clickAirLinkPeriod('month');
      }
      function clickYear() {
        clickAirLinkPeriod('year');
      }
      clickDay();
    </script>
  </body>
</html>
